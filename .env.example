# Copy to .env for local development. Never commit .env.

# --- Database ---
POSTGRES_USER=loanflow
POSTGRES_PASSWORD=loanflow
POSTGRES_DB=loanflow
# Consumed by api + worker. Host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://loanflow:loanflow@db:5432/loanflow

# --- API ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Worker ---
PURGE_AFTER_DAYS=30
HOUSEKEEPING_CRON=0 2 * * *

# --- Web (build-time) ---
VITE_API_BASE_URL=/api
